ARG PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
FROM ${PYTHON_IMAGE} AS builder
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
WORKDIR /workspace
COPY backend/python-ai-service/pyproject.toml backend/python-ai-service/pyproject.toml
WORKDIR /workspace/backend/python-ai-service
RUN pip install --no-cache-dir --index-url="${PIP_INDEX_URL}" --trusted-host="${PIP_TRUSTED_HOST}" --prefix=/install .

ARG PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
FROM ${PYTHON_IMAGE}
WORKDIR /app
ENV PYTHONPATH=/app
COPY --from=builder /install /usr/local
COPY backend/python-ai-service/app /app/app
USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        poppler-utils \
        tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --shell /usr/sbin/nologin appuser
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD python -m app.container_healthcheck "$0" "$@" || exit 1
ENTRYPOINT ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
