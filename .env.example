# Intelligent Report System local development environment.
# Copy to .env for local Docker Compose. Do not commit real production secrets.

APP_ENV=development
APP_NAME=intelligent-report-system

# Container images. Defaults prefer images already used in local Docker.
MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.9.9-eclipse-temurin-17
JAVA_RUNTIME_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jre-alpine
MAVEN_REPO_URL=https://maven.aliyun.com/repository/public
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
NODE_IMAGE=docker.m.daocloud.io/library/node:20.19.5-alpine
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27.3-alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7.2-alpine
ROCKETMQ_IMAGE=docker.m.daocloud.io/apache/rocketmq:4.9.7
MINIO_IMAGE=docker.m.daocloud.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
OPENSEARCH_IMAGE=docker.m.daocloud.io/opensearchproject/opensearch:2.18.0
MILVUS_IMAGE=docker.m.daocloud.io/milvusdb/milvus:v2.5.4

# Java 17 + Spring Boot 3
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JAVA_OPTS=-Xms512m -Xmx1536m
JAVA_HTTP_PORT=18080

# PostgreSQL 16
DB_JDBC_URL=jdbc:postgresql://postgres:5432/intelligent_report
DB_HOST=postgres
DB_PORT=5432
DB_NAME=intelligent_report
DB_USERNAME=report
DB_PASSWORD=report123
POSTGRES_PORT=15432
DATABASE_URL=postgresql://report:report123@postgres:5432/intelligent_report

# Redis
REDIS_HOST=redis
REDIS_PORT=16379
REDIS_PASSWORD=

# MySQL local source connector smoke
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.4
MYSQL_HOST=mysql
MYSQL_PORT=13306
MYSQL_DATABASE=erp_source
MYSQL_USER=erp
MYSQL_PASSWORD=erp123
MYSQL_ROOT_PASSWORD=root123

# RocketMQ
ROCKETMQ_ENDPOINT=rocketmq-namesrv:9876
ROCKETMQ_NAMESRV_PORT=19876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_FAST_PORT=10909
ROCKETMQ_REPORT_TOPIC=report_generation_requested
ROCKETMQ_DOCUMENT_TOPIC=document_parse_requested
ROCKETMQ_KNOWLEDGE_ITEM_DELETED_TOPIC=knowledge_item_deleted
ROCKETMQ_KNOWLEDGE_ITEM_INDEX_REQUESTED_TOPIC=knowledge_item_index_requested
ROCKETMQ_EXPORT_TOPIC=report_export_requested

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=report-artifacts

# Milvus
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=19091
VECTOR_TOP_K=5
VECTOR_SCORE_THRESHOLD=0.70

# OpenSearch
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_PORT=19200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=localDevAdmin123!

# Higress
GATEWAY_TYPE=higress
GATEWAY_HTTP_PORT=18000
GATEWAY_HTTPS_PORT=18443
GATEWAY_METRICS_PORT=15020
AI_GATEWAY_ENABLED=true
AI_GATEWAY_LLM_FALLBACK_ENABLED=true
AI_GATEWAY_TOKEN_RATE_LIMIT_ENABLED=true
AI_GATEWAY_PROMPT_SECURITY_ENABLED=true
AI_GATEWAY_SEMANTIC_CACHE_ENABLED=true
AI_GATEWAY_MCP_PROXY_ENABLED=true
GATEWAY_WAF_ENABLED=true
GATEWAY_JWT_OIDC_ENABLED=true
GATEWAY_PROMETHEUS_ENABLED=true
GATEWAY_TRACING_ENABLED=true

# Online GPT-compatible model first; keep multi-model routing fields.
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt
LLM_BASE_URL=
LLM_API_KEY=
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=30

# Embedding / RAG
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_MAX_CONTEXT_LENGTH=4000

# Token and audit
TOKEN_BUDGET_PER_USER_DAILY=10000
TOKEN_COST_PER_1K=
AUDIT_MODEL_INVOCATION_ENABLED=true
AUDIT_PROMPT_CONTEXT_ENABLED=true

# Security
JWT_SECRET=local-dev-secret-change-me-32-bytes-minimum
JWT_ALGORITHM=HS256
DATA_SOURCE_CREDENTIAL_KEY=local-dev-data-source-credential-key-change-me
DATA_SOURCE_ENDPOINT_ALLOWLIST=localhost,127.0.0.1,::1,host.docker.internal,postgres,mysql,ir-postgres,intelligent-report-system-mysql-1
DATA_SOURCE_SYNC_SCHEDULER_ENABLED=false
DATA_SOURCE_SYNC_SCHEDULER_DELAY_MS=60000
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_CACHE_TTL_SECONDS=300
PROMPT_MAX_LENGTH=2000
ENABLE_PROMPT_INJECTION_CHECK=true
BLOCKED_PATTERNS_FILE=config/prompts/blocked_patterns.txt

# Frontend
WEB_HTTP_PORT=13000
VITE_API_BASE_URL=/api/v1

# Python AI service
PYTHON_HTTP_PORT=18081
